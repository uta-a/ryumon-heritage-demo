{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "noEmit": true,
    "strict": true, "skipLibCheck": true, "noUnusedLocals": true,
    "noUnusedParameters": true, "verbatimModuleSyntax": true
  },
  "include": ["src"]
}
